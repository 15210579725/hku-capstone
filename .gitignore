# ============================================================
# HKU Capstone — .gitignore
# 原则:上传完整代码,排除虚拟环境、模型权重/向量等大文件、缓存与归档。
# 被排除的权重/向量请按各子目录 README 重新下载或生成。
# ============================================================

# ---- 范围外目录(不上传)----
old_file/
_server_edit/
.playwright-mcp/
emotion-probe/
simulation-env/

# ---- 虚拟环境 ----
.venv/
.venv_fe/
venv/
env/bin/
ENV/
.conda/

# ---- Python 缓存 ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.ipynb_checkpoints/
build/
dist/

# ---- 模型权重 / 向量 / 张量(大文件,需另行下载/生成)----
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.gguf
*.onnx
*.npz
*.npy
*.h5
*.pkl
*.pickle
# HuggingFace 本地模型缓存
models--*/
*.arrow

# ---- 压缩包 / 归档 ----
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# ---- 项目特定:大型中间产物(非代码,需另行生成)----

# caption 数据产物与运维目录（代码保留，数据排除）
caption/.venv*/
caption/ARIN7600/
caption/caption_crops/
caption/caption_model_batch_*/
caption/caption_review_videos/
caption/caption_test_output/
caption/gemini_test_results/
caption/mimo_test_*/
caption/mimo_v25_audit_*/
caption/paddleocr_*/
caption/quality_verify/
caption/transcript/
caption/pipelines/out/
caption/pipelines/_watch/
caption/pipelines/throughput_report.html

# ---- 操作系统 / 编辑器 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- 日志 / 临时 ----
*.log
*.tmp
tmp/
.cache/

# ---- 密钥 / 本地配置(防止泄露)----
.env
.env.*
!.env.example
*.local
secrets.*
*credentials*.json
